{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "F=\"$HOME/.local/bin/forge\"; [ -x \"$F\" ] || F=\"${CLAUDE_PLUGIN_ROOT}/bin/forge\"; \"$F\" hook stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "F=\"$HOME/.local/bin/forge\"; [ -x \"$F\" ] || F=\"${CLAUDE_PLUGIN_ROOT}/bin/forge\"; \"$F\" hook session-start",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
